  "introductions": [
    {
      "key": "ice",
      "title": "冰封砖",
      "text": [
        "发现冰里的目标",
        "先击碎外层薄冰",
        "继续命中内部方盒",
        "击碎后完成收集"
      ],
      "rule": "解冻不等于收集；同一次攻击不穿透冰层。",
      "originalPage": "introductions/ice-page.png",
